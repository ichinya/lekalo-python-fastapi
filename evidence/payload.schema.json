{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "FastAPI HTTP route evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "provider",
    "rules_revision",
    "policy_digest",
    "method",
    "path",
    "application_native",
    "handler_native",
    "registration_path",
    "registration_line",
    "sources",
    "confidence"
  ],
  "properties": {
    "provider": {
      "type": "string",
      "maxLength": 64,
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "rules_revision": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]+$"
    },
    "policy_digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "method": {
      "enum": [
        "GET",
        "POST",
        "PUT",
        "PATCH",
        "DELETE",
        "HEAD",
        "OPTIONS",
        "TRACE"
      ]
    },
    "path": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048,
      "pattern": "^/[^\\u0000-\\u001f\\u007f-\\u009f]*$"
    },
    "application_native": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]+$"
    },
    "handler_native": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]+$"
    },
    "operation_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]+$"
    },
    "registration_path": {
      "$ref": "#/$defs/logicalPath"
    },
    "registration_line": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1000000
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "$ref": "#/$defs/httpRouteSource"
      }
    },
    "confidence": {
      "enum": [
        "exact",
        "high",
        "medium",
        "low",
        "unknown"
      ]
    }
  },
  "$defs": {
    "logicalPath": {
      "type": "string",
      "pattern": "^(?!(?:.*[/])?(?:con|prn|aux|nul|com[1-9]|lpt[1-9])(?:[./]|$))(?!(?:.*[/])?\\.{1,2}(?:/|$))(?!.*\\.(?:/|$))[a-z0-9._][a-z0-9._-]{0,63}(?:/[a-z0-9._][a-z0-9._-]{0,63})*$",
      "maxLength": 512
    },
    "httpRouteSource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "source_digest"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/logicalPath"
        },
        "source_digest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        }
      }
    }
  }
}
